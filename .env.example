# ─────────────────────────────────────────────
# 미래의 나에게 짬처리 백엔드 환경 변수 예시
# cp .env.example .env 후 값을 채운다. 실제 비밀 값은 .env 에만 두고 커밋하지 않는다.
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# MySQL 8 연결
DATABASE_URL=mysql://jjam_user:CHANGE_ME@127.0.0.1:3306/jjam
DB_POOL_MAX=10
# 새 DB 연결을 맺을 때까지 기다리는 최대 시간(ms). DB 에 연결할 수 없으면 503
DB_CONNECT_TIMEOUT_MS=3000
# SELECT 최대 실행 시간(ms, MySQL max_execution_time). 넘으면 500
DB_STATEMENT_TIMEOUT_MS=10000

# JWT (jose, HS256). 32자 이상 무작위 문자열. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# 카카오 로그인 (developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_REST_API_KEY=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME
# 카카오 콘솔에 등록한 Redirect URI 와 똑같이. 여러 개면 쉼표로
KAKAO_REDIRECT_URIS=http://localhost:5173/oauth/kakao
KAKAO_TIMEOUT_MS=5000

# 인증 메일 SMTP. 비워 두면 개발 환경에서는 메일 대신 서버 로그에 코드를 찍는다 (운영에서는 필수)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=짬처리 <no-reply@example.com>
MAIL_TIMEOUT_MS=10000

# 개발 전용: 카카오 없이 POST /api/auth/dev-login 으로 로그인 (운영에서는 켤 수 없음)
DEV_LOGIN_ENABLED=false

# 프론트엔드 주소 (웹에서 호출할 때만 필요. React Native 앱은 CORS 와 무관)
CORS_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
